{
  "info": {
    "name": "Restaurant Table Reservation System - API Tests",
    "description": "Postman collection for the REST API. Run with Newman against a server started in test mode (see run_postman.sh).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PM-00 Setup: reset test data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/_reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "_reset"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reset OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "PM-01 Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Body says ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('Responds under 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "PM-02 List tables",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tables",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tables"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json();",
              "pm.test('8 tables', () => pm.expect(t.length).to.eql(8));",
              "pm.test('36 seats in total', () => pm.expect(t.reduce((s, x) => s + x.capacity, 0)).to.eql(36));"
            ]
          }
        }
      ]
    },
    {
      "name": "PM-03 Create reservation (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Priya Sharma\",\n  \"phone\": \"9876543210\",\n  \"email\": \"priya@example.com\",\n  \"party_size\": 2,\n  \"date\": \"2026-11-18\",\n  \"time\": \"13:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test('Status CONFIRMED', () => pm.expect(r.status).to.eql('CONFIRMED'));",
              "pm.test('Smallest table T1 assigned', () => pm.expect(r.table_id).to.eql('T1'));",
              "pm.test('Schema has required fields', () => ['reservation_id','table_id','deposit','end_time'].forEach(k => pm.expect(r).to.have.property(k)));",
              "pm.collectionVariables.set('reservationId', r.reservation_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "PM-04 Get reservation by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservations/{{reservationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservationId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Same ID returned', () => pm.expect(pm.response.json().reservation_id).to.eql(pm.collectionVariables.get('reservationId')));"
            ]
          }
        }
      ]
    },
    {
