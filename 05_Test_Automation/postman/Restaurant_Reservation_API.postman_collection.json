        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Ravi Kumar\",\n  \"phone\": \"12345\",\n  \"email\": \"priya@example.com\",\n  \"party_size\": 2,\n  \"date\": \"2026-11-18\",\n  \"time\": \"13:00\"\n}"
        }
