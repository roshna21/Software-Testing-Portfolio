    {
      "name": "PM-14 Availability shows T8 busy",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/availability?date=2026-11-20&time=19:30",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "availability"
          ],
          "query": [
            {
              "key": "date",
              "value": "2026-11-20"
            },
            {
              "key": "time",
              "value": "19:30"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const t8 = pm.response.json().find(t => t.table_id === 'T8');",
              "pm.test('T8 not available', () => pm.expect(t8.available).to.be.false);"
            ]
          }
        }
