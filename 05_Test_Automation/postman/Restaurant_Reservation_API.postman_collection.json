          "raw": "{\n  \"customer_name\": \"Priya Sharma\",\n  \"phone\": \"9123400002\",\n  \"email\": \"priya@example.com\",\n  \"party_size\": 7,\n  \"date\": \"2026-11-20\",\n  \"time\": \"19:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
