    {
      "name": "PM-08 Overlapping booking at 18:30 refused",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Priya Sharma\",\n  \"phone\": \"9123400003\",\n  \"email\": \"priya@example.com\",\n  \"party_size\": 7,\n  \"date\": \"2026-11-20\",\n  \"time\": \"18:30\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409 Conflict (no double booking)', () => pm.response.to.have.status(409));",
              "pm.test('Code no_table', () => pm.expect(pm.response.json().code).to.eql('no_table'));"
            ]
          }
        }
      ]
    },
